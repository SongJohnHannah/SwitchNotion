{
  "name": "notion-switch-prototype",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/start-desktop.mjs",
    "prepare": "node scripts/prepare-desktop.mjs",
    "status": "node scripts/control.mjs status",
    "stop": "node scripts/control.mjs quit",
    "provider": "node scripts/provider.mjs",
    "notion": "node scripts/notion.mjs",
    "settings": "node scripts/open-settings.mjs",
    "collect": "node scripts/open-collection.mjs",
    "open": "node scripts/open-notion.mjs",
    "update": "node scripts/open-update.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "package:mac": "node scripts/package-macos.mjs",
    "prepare:launchers": "node scripts/prepare-root-launchers.mjs",
    "package:speech": "node scripts/package-speech.mjs",
    "check:secrets": "node scripts/check-staged-secrets.mjs",
    "pretest": "node -e \"require('node:fs').mkdirSync('.notion-switch',{recursive:true})\"",
    "test": "node --test tests/*.test.mjs"
  }
